# Operating system and editor droppings
.DS_Store
._*
Thumbs.db
*~
*.swp
*.bak

# Python (the repository holds scripts)
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Go build and test artifacts
*.exe
*.test
*.prof

# Build products, rebuilt by make; never committed
/bin/
/dist/
/man/
/testout/
*.zip
*.tar.gz
*.tgz
/release_notes.tmp
/_codemeta.json

# Secrets and per-machine configuration: never committed.
# .env and irdmtools.json hold the RDM token and database passwords
# (config.go reads both). The scripts/test_*.bash smoke tests source
# test_*.env and test_rdmutil.rc from the working directory, the same kind of
# file.
.env
*.env
*.rc
*.keys
/irdmtools.json

# Working data and scratch space, kept out of git. Dataset collections (*.ds)
# are built by the tools.
*.ds
/scratch/
/sandbox/
/s3_uploads/
/problem_files/
/reference/
/people.csv
/groups.csv
/file_info_query.sql
/t.txt

# NOTE: testdata/, .github/ and docs/ are deliberately not ignored, and neither
# are whole file types (*.json, *.csv, *.sql, *.yaml, *.bash): fixtures,
# scripts and release files live under those names. The old file ignored them
# and 80 tracked files matched its rules.
